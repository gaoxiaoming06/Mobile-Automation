# Server
PORT=4010

# Runtime data. Defaults to ~/.local/share/mobile-automation when unset.
# DATA_DIR=/Users/Shared/mobile-automation-data

# Android preview and scrcpy tooling.
# SCRCPY_SERVER_PATH=/absolute/path/to/scrcpy-server-v3.3.3
# SCRCPY_STREAM_MAX_SIZE=800
# SCRCPY_STREAM_MAX_FPS=30
# SCRCPY_STREAM_BIT_RATE=2000000
# SCRCPY_STREAM_MAX_WS_BACKLOG_BYTES=524288

# HarmonyOS realtime preview companion.
# The device-agent launches this bundle and forwards localhost:<hostPort> to the
# companion TCP server on the device. Devices without the companion installed
# automatically fall back to screenshot preview in the dashboard.
# Default unsigned/local bundle:
# HARMONY_STREAM_BUNDLE_NAME=com.mobileautomation.screenstream
# Local authorized FlutterProject signing installs the companion as:
# HARMONY_STREAM_BUNDLE_NAME=cn.eeo.hos.classin.mobile.autoverify
# HARMONY_STREAM_ABILITY_NAME=EntryAbility
# HARMONY_STREAM_DEVICE_PORT=28282
# HARMONY_STREAM_MIN_API=23
# HARMONY_STREAM_CONNECT_TIMEOUT_MS=8000
# HARMONY_STREAM_AUTO_AUTHORIZE=1

# iOS WebDriverAgent control. The server auto-detects http://localhost:8100 by default.
# Use the global URL or a UDID-specific URL when the endpoint is not the default.
# IOS_WDA_AUTODETECT=1
# IOS_WDA_DEFAULT_URL=http://localhost:8100
# IOS_WDA_URL=http://localhost:8100
# IOS_WDA_URL_00008020_000260113E04002E=http://localhost:8100

# Artifact cleanup.
# Cleanup is enabled by default but only removes temporary leftovers unless retention is enabled.
# ARTIFACT_CLEANUP_ENABLED=1
# ARTIFACT_RETENTION_ENABLED=0
# PASSED_RUN_RETENTION_DAYS=7
# FAILED_RUN_RETENTION_DAYS=30
# MAX_ARTIFACT_STORAGE_GB=20
# CLEANUP_INTERVAL_HOURS=6
