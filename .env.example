# Server
PORT=4010

# Runtime data. Defaults to ~/.local/share/mobile-automation when unset.
# DATA_DIR=/Users/Shared/mobile-automation-data

# Device Agent. Set these on the host running `pnpm agent`.
# DEVICE_AGENT_SERVER_URL=http://127.0.0.1:4010
# DEVICE_AGENT_ID=my-macbook
# DEVICE_AGENT_SHARED=1
# DEVICE_AGENT_PAIRING_CODE=
# DEVICE_AGENT_MAX_CONCURRENT_RUNS=3

# Local HTTPS dev mode for LAN dashboard access.
# HTTPS=1
# HTTPS_KEY=.cert/mobile-automation-lan-key.pem
# HTTPS_CERT=.cert/mobile-automation-lan-cert.pem

# Android preview and scrcpy tooling.
# SCRCPY_SERVER_PATH=/absolute/path/to/scrcpy-server-v3.3.3
# SCRCPY_STREAM_MAX_SIZE=800
# SCRCPY_STREAM_MAX_FPS=30
# SCRCPY_STREAM_BIT_RATE=2000000
# SCRCPY_STREAM_MAX_WS_BACKLOG_BYTES=524288

# Experimental HarmonyOS stream bridge.
# The dashboard currently uses screenshot polling for HarmonyOS preview. Enable
# this bridge only when testing the companion HAP and server/agent relay
# directly.
# Default unsigned/local bundle:
# HARMONY_STREAM_BUNDLE_NAME=com.mobileautomation.screenstream
# Local authorized FlutterProject signing installs the companion as:
# HARMONY_STREAM_BUNDLE_NAME=cn.eeo.hos.classin.mobile.autoverify
# HARMONY_STREAM_ABILITY_NAME=EntryAbility
# HARMONY_STREAM_ENABLED=1
# HARMONY_STREAM_DEVICE_PORT=28282
# HARMONY_STREAM_MIN_API=23
# HARMONY_STREAM_CONNECT_TIMEOUT_MS=8000
# HARMONY_STREAM_AUTO_AUTHORIZE=1

# iOS WebDriverAgent control. The server auto-detects http://localhost:8100 by default.
# Use the global URL or a UDID-specific URL when the endpoint is not the default.
# IOS_WDA_AUTODETECT=1
# IOS_WDA_DEFAULT_URL=http://localhost:8100
# IOS_WDA_URL=http://localhost:8100
# IOS_WDA_URL_00008020_000260113E04002E=http://localhost:8100

# Artifact cleanup.
# Cleanup is enabled by default but only removes temporary leftovers unless retention is enabled.
# ARTIFACT_CLEANUP_ENABLED=1
# ARTIFACT_RETENTION_ENABLED=0
# PASSED_RUN_RETENTION_DAYS=7
# FAILED_RUN_RETENTION_DAYS=30
# MAX_ARTIFACT_STORAGE_GB=20
# CLEANUP_INTERVAL_HOURS=6

# Optional ScriptFlow AI code-context retrieval for ClassIn apps.
# When enabled, the server retrieves classin-code context before AI draft generation,
# compresses it into externalContext, and never forwards raw source snippets.
# CLASSIN_CODE_CONTEXT_ENABLED=0
# CLASSIN_CODE_EMBEDDING_BASE_URL=https://mobile.eeo-inc.com/code-embedding
# CLASSIN_CODE_SEARCH_BASE_URL=https://mobile.eeo-inc.com
# CLASSIN_CODE_CONTEXT_TIMEOUT_MS=3500
# CLASSIN_CODE_CONTEXT_TOP_K=3
# CLASSIN_CODE_CONTEXT_MAX_SEMANTIC_QUERIES=2
# CLASSIN_CODE_CONTEXT_MAX_EXACT_QUERIES=3
# CLASSIN_CODE_CONTEXT_REPOS=ClassInX,ClassIn
# CLASSIN_CODE_CONTEXT_USER=mobile-automation
# CLASSIN_CODE_API_TOKEN=

# MCP adapter. Set this when running `pnpm --filter @mobile-automation/mcp-adapter start`
# against a non-default server.
# MOBILE_AUTOMATION_SERVER_URL=http://127.0.0.1:4010
